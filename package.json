{
  "name": "dsh-cgss-idol-theme",
  "version": "1.3.0",
  "author": "AlyceStocking",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlyceStocking/dsh-cgss-idol-theme.git"
  },
  "homepage": "https://github.com/AlyceStocking/dsh-cgss-idol-theme#readme",
  "bugs": { "url": "https://github.com/AlyceStocking/dsh-cgss-idol-theme/issues" },
  "keywords": ["deepseek-harness", "dsh-plugin", "theme", "cgss"],
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org/" },
  "description": "CGSS 偶像主题：多角色 Web 配色与卡面、沉浸阅读、Windows 桌宠和会话提醒。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "desktop",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "build:client": "node scripts/build-client.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test tests/*.test.mjs",
    "desktop:package": "node scripts/package-desktop.mjs",
    "desktop:preview": "node scripts/preview-desktop.mjs",
    "desktop:install": "node scripts/install-desktop.mjs",
    "desktop:sync": "node scripts/sync-desktop.mjs",
    "build:characters": "node scripts/build-characters.mjs",
    "audit:roster": "node scripts/audit-roster.mjs",
    "audit:dialogue": "node scripts/audit-dialogue.mjs",
    "audit:serifu": "node scripts/audit-serifu.mjs"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "electron": "44.5.1"
  }
}
